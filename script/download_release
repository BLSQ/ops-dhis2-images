#!/bin/bash
# Download a DHIS2 war into ./releases and verify its checksum.
# Usage: ./script/download_release <DHIS2_FULL_VERSION> <URL> [SHA256]

set -euo pipefail

DHIS2_FULL_VERSION=$1
URL=$2
SHA256=${3:-}

mkdir -p ./releases
file=./releases/dhis2-stable-$DHIS2_FULL_VERSION.war

verify() {
    [ -z "$SHA256" ] && return 0
    echo "$SHA256  $file" | shasum -a 256 -c --status
}

if [ -f "$file" ] && verify; then
    echo "Using cached $file"
    exit 0
fi

echo "Downloading $URL"
curl -fL --retry 3 -o "$file" "$URL"

if ! verify; then
    echo "Checksum mismatch for $file" >&2
    rm -f "$file"
    exit 1
fi
